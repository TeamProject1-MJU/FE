# 서버 주소는 /api/v1까지 포함합니다. 끝 슬래시는 클라이언트에서 정리합니다.
# 안드로이드 에뮬레이터에서 PC 서버에 연결할 때는 localhost 대신 10.0.2.2를 사용합니다.
# 예: http://10.0.2.2:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=

# 생략하면 true입니다. 정확히 true일 때만 mock을 사용합니다.
EXPO_PUBLIC_USE_MOCK=true

EXPO_PUBLIC_KAKAO_REST_API_KEY=

EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=


# 가율, 창범이는 나중에 이거 값 생기면 알려줄테니 일단 비워둘 것
